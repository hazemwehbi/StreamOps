# Générez des valeurs locales avec scripts/bootstrap.ps1 ou scripts/bootstrap.sh.
# Les mots de passe SQL doivent être compatibles avec les URI ; les scripts génèrent de l’hexadécimal.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
ADMIN_TOKEN=
READ_TOKEN=
METRICS_TOKEN=
HTTP_PORT=8080
DB_POOL_MAX=10
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
CORS_ORIGIN=
# À activer avec docker compose --profile monitoring up -d :
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Pour l’exécution directe uniquement ; Compose définit sa propre DATABASE_URL.
DATABASE_URL=
